<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.leads.microcube.verifidadmin</groupId>
        <artifactId>microcube.verifidadmin</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>microcube.verifidadmin-provider</artifactId>
    <packaging>jar</packaging>
    <name>verifidadmin-provider</name>

    <dependencies>
        <!-- Microcube -->
        <dependency>
            <groupId>com.leads.microcube</groupId>
            <artifactId>microcube.core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.leads.microcube.verifidadmin</groupId>
            <artifactId>microcube.verifidadmin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.leads.microcube.verifidadmin</groupId>
            <artifactId>microcube.verifidadmin-service</artifactId>
        </dependency>

        <!-- Oracle database driver-->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludeDevtools>true</excludeDevtools>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
