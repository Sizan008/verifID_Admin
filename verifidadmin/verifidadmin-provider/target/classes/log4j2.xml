<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="DEBUG">
    <Properties>
        <Property name="LOG_PATH">logs</Property>
        <Property name="APP_NAME" value="${spring:spring.application.name}"/>
        <Property name="SOCKET_HOST" value="${spring:microcube.logging.socket.host}"/>
        <Property name="SOCKET_PORT" value="${spring:microcube.logging.socket.port}"/>
        <Property name="LOGGING_LEVEL" value="${spring:microcube.logging.level}"/>
        <Property name="LOG_PATTERN">[%d{HH:mm:ss.SSS}] [%t] [%-5level] %c{1.} - %msg%n</Property>
    </Properties>
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="FileAppender" fileName="${LOG_PATH}/${APP_NAME}.log"
                     filePattern="${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
        </RollingFile>

        <Socket name="LogstashAppender" host="${SOCKET_HOST}" port="${SOCKET_PORT}" reconnectionDelayMillis="3000">
            <JsonLayout compact="true" eventEol="true" locationInfo="true" includeStacktrace="true"/>
        </Socket>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="ConsoleAppender"/>
        </Root>
        <Logger name="com.leads.microcube" level="${LOGGING_LEVEL}" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
            <AppenderRef ref="LogstashAppender"/>
        </Logger>
    </Loggers>
</Configuration>